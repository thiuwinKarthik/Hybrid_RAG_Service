# Application Configuration
NODE_ENV=development
PORT=4000
FASTAPI_PORT=8000
REACT_PORT=3000

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_enterprise
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=rag_secure_password_2026
DATABASE_URL=postgres://rag_admin:rag_secure_password_2026@localhost:5432/rag_enterprise

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_documents

# RAG & NLP Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=gemini  # Options: gemini, openai, mock, ollama
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-pro # Options: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash, gpt-4o-mini


# Security
JWT_SECRET=super_secret_jwt_key_enterprise_rag_2026
JWT_EXPIRES_IN=7d

# Gateway URL for Frontend
VITE_API_GATEWAY_URL=http://localhost:4000
